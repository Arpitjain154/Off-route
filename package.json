{
  "name": "idr-navigator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-capacitor.cjs",
    "dev": "concurrently -k -n api,app \"npm run dev -w server\" \"vite --host 0.0.0.0\"",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "test": "npm test -w server",
    "test:maps": "node --test scripts/test-map-tiles.mjs scripts/test-mp-map.mjs",
    "db:start": "node scripts/local-mongo.mjs"
  },
  "dependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/core": "6.2.1",
    "@capacitor/filesystem": "6.0.3",
    "axios": "^1.12.0",
    "headroom-ai": "^0.37.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.9.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-map-gl": "^8.1.3",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "@playwright/test": "^1.51.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "geojson-vt": "^4.0.2",
    "mongodb-memory-server": "^10.1.4",
    "prettier": "^3.9.6",
    "prettier-plugin-java": "^2.10.3",
    "typescript": "~5.6.3",
    "vite": "^6.4.0",
    "vt-pbf": "^3.1.3"
  },
  "overrides": {
    "tar": "^7.5.21",
    "qs": "^6.16.0"
  }
}

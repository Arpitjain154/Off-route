MONGO_URI=mongodb://127.0.0.1:27017/idr_navigator
PORT=3001
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,http://localhost
# Set for shared deployments; also enter in app Settings. Required in production.
API_KEY=
